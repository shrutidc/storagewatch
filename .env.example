# Backend + collector config. Copy to .env and fill in.
# The frontend has its own frontend/.env — see frontend/.env.example.

# Tiger Data (PostgreSQL/TimescaleDB).
# URL-encode special characters in the password: @ becomes %40.
TIGER_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Backboard (AI analysis + chat).
# Leave as mock-key to run without AI — the app falls back to canned text.
# For real answers, add a BYOK provider key in the Backboard dashboard
# (Settings -> API Keys); Backboard's own free credits do not cover LLM chat.
BACKBOARD_API_KEY=mock-key

# Auth0 — the backend verifies access tokens against this tenant/API.
# AUTH0_AUDIENCE must match VITE_AUTH0_AUDIENCE in frontend/.env and be
# registered under Applications -> APIs in the Auth0 dashboard.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=storagewatch-api

# Optional. The collector connects itself on first run: it opens the dashboard,
# you sign in and click Connect, and it saves its token to
# ~/.storagewatch/agent_token. Set this only to override that, e.g. on a
# machine with no browser.
AGENT_TOKEN=

# Where the collector sends telemetry. Point this at the backend's host when
# the agent and backend aren't on the same machine.
BACKEND_URL=http://localhost:8000

# Where the collector opens the sign-in page. Defaults to BACKEND_URL, or to
# the Vite dev server (http://localhost:3000) when BACKEND_URL is local.
# DASHBOARD_URL=
