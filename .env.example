# Backend + collector config. Copy to .env and fill in.
# The frontend has its own frontend/.env — see frontend/.env.example.

# Tiger Data (PostgreSQL/TimescaleDB).
# URL-encode special characters in the password: @ becomes %40.
TIGER_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Backboard (AI analysis + chat).
# Leave as mock-key to run without AI — the app falls back to canned text.
# For real answers, add a BYOK provider key in the Backboard dashboard
# (Settings -> API Keys); Backboard's own free credits do not cover LLM chat.
BACKBOARD_API_KEY=mock-key

# ElevenLabs — only used by /api/tts, which requires a paid ElevenLabs plan.
# Optional; leave unset.
ELEVENLABS_API_KEY=

# Where the collector sends telemetry. Point this at the backend's host when
# the agent and backend aren't on the same machine.
BACKEND_URL=http://localhost:8000
