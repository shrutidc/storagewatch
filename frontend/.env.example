# Copy to frontend/.env and fill in.
#
# Vite only exposes variables prefixed with VITE_, and only reads .env from
# this directory — not the project root. Values come from the Auth0
# dashboard: Applications -> your app -> Settings.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=storagewatch-api
